generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CycleType {
  ANNUAL
  MID_YEAR
  PROBATION
  CUSTOM
}

enum CyclePhase {
  GOAL_SETTING
  SELF_ASSESSMENT
  MANAGER_REVIEW
  CALIBRATION
  COMPLETED
}

enum CycleStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum AppraisalStatus {
  PENDING
  SELF_SUBMITTED
  MANAGER_SUBMITTED
  FINALISED
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  MISSED
  CANCELLED
}

enum GoalCategory {
  PERFORMANCE
  DEVELOPMENT
  ORGANIZATIONAL
}

enum PipStatus {
  ACTIVE
  COMPLETED
  EXTENDED
  TERMINATED
}

enum IncrementStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum FeedbackReviewerType {
  PEER
  SUBORDINATE
  SUPERVISOR
}

enum FeedbackRequestStatus {
  PENDING_APPROVAL
  APPROVED
  SUBMITTED
  DECLINED
}

enum FeedbackQuestionType {
  RATING
  TEXT
}

model ReviewCycle {
  id           String      @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  name         String
  type         CycleType
  startDate    DateTime
  endDate      DateTime
  currentPhase CyclePhase  @default(GOAL_SETTING)
  status       CycleStatus @default(DRAFT)
  description  String?
  createdBy    String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  appraisals          Appraisal[]
  calibrationLockedAt DateTime?
  incrementBudgetPct  Float?
  incrementProposals  IncrementProposal[]
  feedbackWeight      Float?              @default(0.0)
  feedbackRequests    FeedbackRequest[]
  feedbackQuestions   FeedbackQuestion[]
  bellCurveConfig     BellCurveConfig?

  @@index([tenantId])
  @@map("review_cycles")
}

model BellCurveConfig {
  id        String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  cycleId   String   @unique
  bands     Json
  createdBy String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle ReviewCycle @relation(fields: [cycleId], references: [id])

  @@index([tenantId])
  @@map("bell_curve_configs")
}

model Appraisal {
  id               String          @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  cycleId          String
  employeeId       String
  managerId        String?
  selfScore        Float?
  managerScore     Float?
  overallScore     Float?
  selfComments     String?
  managerComments  String?
  strengths        String?
  improvements     String?
  status           AppraisalStatus @default(PENDING)
  selfSubmittedAt  DateTime?
  managerSubmittedAt DateTime?
  finalisedAt        DateTime?
  calibratedScore    Float?
  calibratedAt       DateTime?
  calibratedBy       String?
  score360           Float?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  cycle             ReviewCycle       @relation(fields: [cycleId], references: [id])
  incrementProposal IncrementProposal?

  @@unique([cycleId, employeeId])
  @@index([tenantId])
  @@map("appraisals")
}

model IncrementProposal {
  id             String          @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  cycleId        String
  appraisalId    String          @unique
  employeeId     String
  proposedPct    Float
  proposedAmount Float?
  status         IncrementStatus @default(DRAFT)
  approvedBy     String?
  approvedAt     DateTime?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  cycle     ReviewCycle @relation(fields: [cycleId], references: [id])
  appraisal Appraisal   @relation(fields: [appraisalId], references: [id])

  @@index([tenantId])
  @@map("increment_proposals")
}

model Goal {
  id          String       @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId  String
  cycleId     String?
  title       String
  description String?
  targetDate  DateTime?
  progress    Int          @default(0)
  status      GoalStatus   @default(ACTIVE)
  category    GoalCategory @default(PERFORMANCE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId])
  @@map("goals")
}

model PipRecord {
  id             String    @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId     String
  managerId      String
  startDate      DateTime
  endDate        DateTime
  objectives     String
  progressNotes  String?
  status         PipStatus @default(ACTIVE)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
  @@map("pip_records")
}

// ─── 360-Degree Feedback (PMS-006) ────────────────────────────────────────────

model FeedbackQuestion {
  id           String               @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  cycleId      String
  questionText String
  questionType FeedbackQuestionType @default(RATING)
  category     String?
  weight       Float                @default(1.0)
  displayOrder Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  cycle     ReviewCycle      @relation(fields: [cycleId], references: [id])
  responses FeedbackResponse[]

  @@index([cycleId])
  @@index([tenantId])
  @@map("feedback_questions")
}

model FeedbackRequest {
  id                 String                @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  cycleId            String
  subjectEmployeeId  String
  reviewerEmployeeId String
  reviewerType       FeedbackReviewerType
  status             FeedbackRequestStatus @default(PENDING_APPROVAL)
  nominatedBy        String
  nominatedAt        DateTime              @default(now())
  approvedBy         String?
  approvedAt         DateTime?
  submittedAt        DateTime?
  declinedReason     String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  cycle     ReviewCycle      @relation(fields: [cycleId], references: [id])
  responses FeedbackResponse[]

  @@unique([cycleId, subjectEmployeeId, reviewerEmployeeId])
  @@index([cycleId])
  @@index([subjectEmployeeId])
  @@index([reviewerEmployeeId])
  @@index([tenantId])
  @@map("feedback_requests")
}

model FeedbackResponse {
  id          String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  requestId   String
  questionId  String
  ratingValue Float?
  textValue   String?
  createdAt   DateTime @default(now())

  request  FeedbackRequest  @relation(fields: [requestId], references: [id])
  question FeedbackQuestion @relation(fields: [questionId], references: [id])

  @@unique([requestId, questionId])
  @@index([tenantId])
  @@map("feedback_responses")
}

// ─── ENG-003 Succession Planning ──────────────────────────────────────────────

enum ReadinessLevel {
  READY_NOW
  ONE_YEAR
  TWO_YEARS
}

enum SuccessionRisk {
  HIGH
  MEDIUM
  LOW
}

enum DevPlanStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model KeyPosition {
  id              String         @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  jobTitle        String
  department      String?
  description     String?
  currentHolderId String?
  isActive        Boolean        @default(true)
  riskLevel       SuccessionRisk @default(HIGH)
  createdBy       String
  updatedBy       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  nominees SuccessorNominee[]

  @@index([department])
  @@index([riskLevel])
  @@index([tenantId])
  @@map("key_positions")
}

model SuccessorNominee {
  id            String         @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  positionId    String
  employeeId    String
  readiness     ReadinessLevel
  potentialBand Int
  notes         String?
  nominatedBy   String
  nominatedAt   DateTime       @default(now())
  updatedBy     String?
  updatedAt     DateTime       @updatedAt

  position KeyPosition        @relation(fields: [positionId], references: [id])
  devPlans SuccessionDevPlan[]

  @@unique([positionId, employeeId])
  @@index([employeeId])
  @@index([tenantId])
  @@map("successor_nominees")
}

model SuccessionDevPlan {
  id                String        @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  nomineeId         String
  competencyGap     String
  action            String
  trainingProgramId String?
  targetDate        DateTime?
  status            DevPlanStatus @default(PENDING)
  completedAt       DateTime?
  notes             String?
  createdBy         String
  updatedBy         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  nominee SuccessorNominee @relation(fields: [nomineeId], references: [id])

  @@index([nomineeId])
  @@index([tenantId])
  @@map("succession_dev_plans")
}
