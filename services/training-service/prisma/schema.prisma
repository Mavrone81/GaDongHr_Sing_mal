generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProgramCategory {
  COMPLIANCE
  TECHNICAL
  SOFT_SKILLS
  LEADERSHIP
  ONBOARDING
  SAFETY
}

enum MaterialType {
  VIDEO
  DOCUMENT
  QUIZ
  LINK
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  DROPPED
}

enum CertStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  REVOKED
}

model TrainingProgram {
  id           String          @id @default(uuid())
  title        String
  description  String?
  category     ProgramCategory @default(TECHNICAL)
  status       ProgramStatus   @default(DRAFT)
  durationMins Int?
  passingScore Int?
  thumbnail    String?
  isMandatory  Boolean         @default(false)
  createdBy    String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  materials   TrainingMaterial[]
  enrollments TrainingEnrollment[]

  @@map("training_programs")
}

model TrainingMaterial {
  id           String       @id @default(uuid())
  programId    String
  title        String
  type         MaterialType @default(DOCUMENT)
  url          String?
  content      String?
  orderIndex   Int          @default(0)
  durationMins Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  program TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("training_materials")
}

model TrainingEnrollment {
  id          String           @id @default(uuid())
  programId   String
  employeeId  String
  status      EnrollmentStatus @default(ENROLLED)
  progress    Int              @default(0)
  score       Int?
  enrolledBy  String?
  dueDate     DateTime?
  enrolledAt  DateTime         @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  program          TrainingProgram          @relation(fields: [programId], references: [id])
  materialProgress TrainingMaterialProgress[]

  @@unique([programId, employeeId])
  @@map("training_enrollments")
}

model TrainingMaterialProgress {
  id           String   @id @default(uuid())
  enrollmentId String
  materialId   String
  score        Int?
  completedAt  DateTime @default(now())

  enrollment TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, materialId])
  @@map("training_material_progress")
}

model EmployeeCertification {
  id          String     @id @default(uuid())
  employeeId  String
  certName    String
  issuingBody String?
  certNumber  String?
  issuedAt    DateTime?
  expiresAt   DateTime?
  status      CertStatus @default(ACTIVE)
  documentUrl String?
  notes       String?
  createdBy   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("employee_certifications")
}
