generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProgramCategory {
  COMPLIANCE
  TECHNICAL
  SOFT_SKILLS
  LEADERSHIP
  ONBOARDING
  SAFETY
}

enum MaterialType {
  VIDEO
  DOCUMENT
  QUIZ
  LINK
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  DROPPED
}

enum CertStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  REVOKED
}

model TrainingProgram {
  id           String          @id @default(uuid())
  title        String
  description  String?
  category     ProgramCategory @default(TECHNICAL)
  status       ProgramStatus   @default(DRAFT)
  durationMins Int?
  passingScore Int?
  thumbnail    String?
  isMandatory  Boolean         @default(false)
  // ─── TRN-003 government grant configuration ────────────────────────────────
  isSsgFunded     Boolean  @default(false)  // SkillsFuture Singapore funded course
  ssgCourseCode   String?                   // TGS-XXXXXXXXX (SkillsFuture course reference)
  etsEligible     Boolean  @default(false)  // Enhanced Training Support — additional grant percentage
  sfecEligible    Boolean  @default(false)  // SkillsFuture Enterprise Credit eligible
  apHourlyRate    Float?                    // Absentee Payroll rate (SGD/hour); default SGD 7.50
  courseFee       Float?                    // gross course fee (per seat) for grant claim
  grantPercentage Float?                    // SSG grant % of course fee (0..1), e.g. 0.7 baseline, 0.9 with ETS
  createdBy    String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  materials       TrainingMaterial[]
  enrollments     TrainingEnrollment[]
  competencies    ProgramCompetency[]
  renewalForCerts EmployeeCertification[] @relation("RenewalProgram")
  grantClaims     GrantClaim[]

  @@map("training_programs")
}

model TrainingMaterial {
  id           String       @id @default(uuid())
  programId    String
  title        String
  type         MaterialType @default(DOCUMENT)
  url          String?
  content      String?
  orderIndex   Int          @default(0)
  durationMins Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  program TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("training_materials")
}

model TrainingEnrollment {
  id          String           @id @default(uuid())
  programId   String
  employeeId  String
  status      EnrollmentStatus @default(ENROLLED)
  progress    Int              @default(0)
  score       Int?
  enrolledBy  String?
  dueDate     DateTime?
  enrolledAt  DateTime         @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  // ─── TRN-003 absentee-payroll & SFC tracking ──────────────────────────────
  trainingHours      Float?       // actual training hours for AP grant computation
  attendanceDate     DateTime?    // first session attended (for AP claim period)
  apComputedAmount   Float?       // computed Absentee Payroll = hours × rate
  apClaimed          Boolean   @default(false)
  sfcDeclaredAmount  Float?       // SkillsFuture Credit declared by employee toward this course

  program          TrainingProgram          @relation(fields: [programId], references: [id])
  materialProgress TrainingMaterialProgress[]
  grantClaims      GrantClaim[]

  @@unique([programId, employeeId])
  @@map("training_enrollments")
}

model TrainingMaterialProgress {
  id           String   @id @default(uuid())
  enrollmentId String
  materialId   String
  score        Int?
  completedAt  DateTime @default(now())

  enrollment TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, materialId])
  @@map("training_material_progress")
}

model EmployeeCertification {
  id               String     @id @default(uuid())
  employeeId       String
  certName         String
  issuingBody      String?
  certNumber       String?
  issuedAt         DateTime?
  expiresAt        DateTime?
  status           CertStatus @default(ACTIVE)
  documentUrl      String?
  notes            String?
  renewalProgramId String?
  competencyId     String?
  createdBy        String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  renewalProgram TrainingProgram? @relation("RenewalProgram", fields: [renewalProgramId], references: [id])
  competency     Competency?      @relation(fields: [competencyId], references: [id])
  reminders      CertReminder[]

  @@index([employeeId])
  @@index([expiresAt])
  @@map("employee_certifications")
}

// ── TRN-004 completion ────────────────────────────────────────────────────────
// CertReminder: idempotent record that a 90/60/30-day reminder has fired for a
// given certification. The daily scheduler uses (certId, threshold) as the
// dedupe key so re-runs don't double-fire.
model CertReminder {
  id        String   @id @default(uuid())
  certId    String
  threshold Int
  daysUntil Int
  sentAt    DateTime @default(now())

  certification EmployeeCertification @relation(fields: [certId], references: [id], onDelete: Cascade)

  @@unique([certId, threshold])
  @@index([sentAt])
  @@map("cert_reminders")
}

// Competency framework: skills tracked across the company. A program teaches
// competencies at a given level; a job family requires competencies at a given
// level; an employee is assessed at a given level. Gap = required − assessed.
model Competency {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programs              ProgramCompetency[]
  jobFamilyRequirements JobFamilyCompetency[]
  employeeAssessments   EmployeeCompetency[]
  certifications        EmployeeCertification[]

  @@map("competencies")
}

model ProgramCompetency {
  id           String   @id @default(uuid())
  programId    String
  competencyId String
  taughtLevel  Int
  createdAt    DateTime @default(now())

  program    TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  competency Competency      @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([programId, competencyId])
  @@map("program_competencies")
}

model JobFamilyCompetency {
  id            String   @id @default(uuid())
  jobFamily     String
  competencyId  String
  requiredLevel Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([jobFamily, competencyId])
  @@index([jobFamily])
  @@map("job_family_competencies")
}

model EmployeeCompetency {
  id            String   @id @default(uuid())
  employeeId    String
  competencyId  String
  assessedLevel Int
  assessedBy    String?
  notes         String?
  assessedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([employeeId, competencyId])
  @@index([employeeId])
  @@map("employee_competencies")
}

// ─── TRN-003 SkillsFuture / SSG / SFEC tracking ───────────────────────────────

// Per-employee SkillsFuture Credit balance. Personal credit issued by MOE that
// employees can use (declare) toward training. Tracks running balance and
// lifetime totals; declarations decrement balance.
model EmployeeSfcBalance {
  id               String   @id @default(uuid())
  employeeId       String   @unique
  balanceAmount    Float    @default(0)
  lifetimeReceived Float    @default(0)
  lifetimeUsed     Float    @default(0)
  lastDeclaredAt   DateTime?
  updatedAt        DateTime @updatedAt
  updatedBy        String

  @@map("employee_sfc_balances")
}

// Company-wide SkillsFuture Enterprise Credit ledger. SFEC is a one-time SGD
// 10,000 credit per company that covers 90% of out-of-pocket on supported
// programmes. Stored as a singleton row keyed by `id = 'singleton'`.
model SfecLedger {
  id          String   @id @default("singleton")
  totalCredit Float    @default(10000)
  usedAmount  Float    @default(0)
  notes       String?
  updatedAt   DateTime @updatedAt
  updatedBy   String

  @@map("sfec_ledger")
}

// Grant claim record — tracks every claim against SSG ETS / Absentee Payroll /
// SFEC / SFC. Each claim links to an enrollment + program; aggregated for reports.
model GrantClaim {
  id             String          @id @default(uuid())
  enrollmentId   String?         // null if pre-enrollment claim
  programId      String
  employeeId     String
  claimType      GrantClaimType
  claimAmount    Float
  status         GrantClaimStatus @default(PENDING)
  submissionRef  String?         // SSG submission reference number
  notes          String?
  createdBy      String
  submittedAt    DateTime?
  paidAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  program    TrainingProgram     @relation(fields: [programId], references: [id])
  enrollment TrainingEnrollment? @relation(fields: [enrollmentId], references: [id])

  @@index([programId])
  @@index([employeeId])
  @@index([claimType])
  @@index([status])
  @@map("grant_claims")
}

enum GrantClaimType {
  ETS      // Enhanced Training Support (course-fee grant)
  AP       // Absentee Payroll (training-hours × rate)
  SFEC     // SkillsFuture Enterprise Credit
  SFC      // SkillsFuture Credit (employee personal)
}

enum GrantClaimStatus {
  PENDING
  SUBMITTED
  APPROVED
  PAID
  REJECTED
}
