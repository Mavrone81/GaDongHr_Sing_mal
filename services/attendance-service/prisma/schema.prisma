// Prisma schema for attendance-service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AttendanceRecord {
  id             String    @id @default(uuid())
  employeeId     String
  date           DateTime
  clockIn        DateTime?
  clockOut       DateTime?
  hoursWorked    Float?
  otHours        Float     @default(0)
  status         AttStatus @default(PRESENT)
  notes          String?
  // Geolocation
  clockInLat     Float?
  clockInLng     Float?
  clockOutLat    Float?
  clockOutLng    Float?
  withinGeofence Boolean?
  locationName   String?   // name of the matched location
  // ── TAT-005 scheduled-time reconciliation ────────────────────────────────
  // Captured from the matching RosterEntry → Shift{Template,WorkingShift} at
  // clock-in / clock-out time. If the employee has no roster entry for the
  // date, scheduledStart/End stay null and both delta statuses are NOT_APPLICABLE.
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  // Minutes the employee clocked in BEFORE scheduledStart, or clocked out
  // AFTER scheduledEnd. Always non-negative — short hours (clocking in late
  // or out early) count automatically against the employee and are not
  // captured here.
  earlyMinutes      Int          @default(0)
  lateMinutes       Int          @default(0)
  // Per-side delta status. AUTO_APPROVED = within shift grace; PENDING =
  // outside grace, manager review required; APPROVED/DENIED = manager
  // decision; NOT_APPLICABLE = no delta on that side.
  earlyStatus       DeltaStatus  @default(NOT_APPLICABLE)
  lateStatus        DeltaStatus  @default(NOT_APPLICABLE)
  earlyApprovedBy   String?
  earlyApprovedAt   DateTime?
  earlyDenyReason   String?
  lateApprovedBy    String?
  lateApprovedAt    DateTime?
  lateDenyReason    String?
  // Billable hours after clipping unapproved early/late time to scheduled
  // bounds. Recomputed by the reconciliation engine on every status change.
  // Payroll auto-feed reads these (NOT raw hoursWorked / otHours).
  billableHours     Float?
  billableOtHours   Float        @default(0)
  createdAt         DateTime     @default(now())

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([earlyStatus])
  @@index([lateStatus])
  @@map("attendance_records")
}

enum DeltaStatus {
  NOT_APPLICABLE
  AUTO_APPROVED
  PENDING
  APPROVED
  DENIED
}

model WorkLocation {
  id             String    @id @default(uuid())
  name           String
  postalCode     String
  address        String
  latitude       Float
  longitude      Float
  radiusMetres   Int       @default(200)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employeeLocations EmployeeWorkLocation[]

  @@map("work_locations")
}

model EmployeeWorkLocation {
  id             String       @id @default(uuid())
  employeeId     String
  workLocationId String
  workLocation   WorkLocation @relation(fields: [workLocationId], references: [id], onDelete: Cascade)
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([employeeId, workLocationId])
  @@index([employeeId])
  @@map("employee_work_locations")
}

model ShiftTemplate {
  id                String   @id @default(uuid())
  name              String
  startTime         String   // HH:mm
  endTime           String   // HH:mm
  breakMinutes      Int      @default(60)
  hoursPerDay       Float    @default(8)
  color             String   @default("#6366f1") // hex colour for calendar display
  // TAT-005: time within ± grace of scheduled bounds is auto-approved (no
  // manager workflow). Default 15 min each side — tunable per shift.
  graceMinutesEarly Int      @default(15)
  graceMinutesLate  Int      @default(15)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  rosterEntries RosterEntry[]
  @@map("shift_templates")
}

model Schedule {
  id              String   @id @default(uuid())
  employeeId      String
  shiftTemplateId String
  startDate       DateTime
  endDate         DateTime?
  createdAt       DateTime @default(now())

  @@index([employeeId])
  @@map("schedules")
}

model RosterEntry {
  id              String    @id @default(uuid())
  employeeId      String
  shiftTemplateId String?
  workingShiftId  String?
  shiftPatternId  String?
  date            DateTime  @db.Date
  locationId      String?
  note            String?
  publishedAt     DateTime?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shiftTemplate   ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id])
  workingShift    WorkingShift?  @relation(fields: [workingShiftId], references: [id], onDelete: SetNull)
  shiftPattern    ShiftPattern?  @relation(fields: [shiftPatternId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date])
  @@map("roster_entries")
}

model ShiftProject {
  id            String        @id @default(uuid())
  name          String
  description   String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workingShifts WorkingShift[]
  shiftPatterns ShiftPattern[]
  members       ProjectMember[]

  @@map("shift_projects")
}

model WorkingShift {
  id                String    @id @default(uuid())
  projectId         String
  name              String
  workMon           Boolean   @default(false)
  workTue           Boolean   @default(false)
  workWed           Boolean   @default(false)
  workThu           Boolean   @default(false)
  workFri           Boolean   @default(false)
  workSat           Boolean   @default(false)
  workSun           Boolean   @default(false)
  startTime         String
  endTime           String
  breakMinutes      Int       @default(60)
  hoursPerDay       Float     @default(8)
  color             String    @default("#6366f1")
  // TAT-005: per-shift grace window — see ShiftTemplate.graceMinutesEarly.
  graceMinutesEarly Int       @default(15)
  graceMinutesLate  Int       @default(15)
  isRecurring       Boolean   @default(true)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project        ShiftProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignments    ShiftAssignment[]
  rosterEntries  RosterEntry[]
  projectMembers ProjectMember[]

  @@index([projectId])
  @@map("working_shifts")
}

model ShiftPattern {
  id            String    @id @default(uuid())
  projectId     String
  name          String
  patternType   String    @default("CUSTOM")
  workDays      Int       @default(5)
  offDays       Int       @default(2)
  startTime     String
  endTime       String
  breakMinutes  Int       @default(60)
  hoursPerShift Float     @default(8)
  color         String    @default("#6366f1")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project        ShiftProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignments    ShiftAssignment[]
  projectMembers ProjectMember[]
  rosterEntries  RosterEntry[]

  @@index([projectId])
  @@map("shift_patterns")
}

model ProjectMember {
  id             String        @id @default(uuid())
  projectId      String
  employeeId     String
  workingShiftId String?
  shiftPatternId String?
  startDate      DateTime      @db.Date
  createdAt      DateTime      @default(now())

  project        ShiftProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workingShift   WorkingShift? @relation(fields: [workingShiftId], references: [id], onDelete: SetNull)
  shiftPattern   ShiftPattern? @relation(fields: [shiftPatternId], references: [id], onDelete: SetNull)

  @@unique([projectId, employeeId])
  @@index([projectId])
  @@map("project_members")
}

model ShiftAssignment {
  id             String        @id @default(uuid())
  employeeId     String
  workingShiftId String?
  shiftPatternId String?
  startDate      DateTime      @db.Date
  endDate        DateTime?     @db.Date
  createdAt      DateTime      @default(now())

  workingShift   WorkingShift? @relation(fields: [workingShiftId], references: [id], onDelete: Cascade)
  shiftPattern   ShiftPattern? @relation(fields: [shiftPatternId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("shift_assignments")
}

model AuditLog {
  id            String   @id @default(uuid())
  entityType    String
  entityId      String?
  entityName    String?
  action        String
  actorId       String?
  actorEmail    String?
  actorRole     String?
  changedFields Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([entityType])
  @@index([createdAt])
  @@map("attendance_audit_logs")
}

enum AttStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  PUBLIC_HOLIDAY
}

// TAT-005: Attendance period lock + HR approval gate.
// One row per "YYYY-MM" period. Drives the payroll auto-feed handshake.
// Lifecycle: OPEN → LOCKED → APPROVED_FOR_PAYROLL. Unlocking goes back to OPEN.
model AttendancePeriod {
  id          String         @id @default(uuid())
  period      String         @unique          // "YYYY-MM"
  status      PeriodStatus   @default(OPEN)
  lockedBy    String?
  lockedAt    DateTime?
  approvedBy  String?
  approvedAt  DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@map("attendance_periods")
}

enum PeriodStatus {
  OPEN
  LOCKED
  APPROVED_FOR_PAYROLL
}
