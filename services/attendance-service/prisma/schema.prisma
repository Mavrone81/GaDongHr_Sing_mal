// Prisma schema for attendance-service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AttendanceRecord {
  id             String    @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId     String
  date           DateTime
  clockIn        DateTime?
  clockOut       DateTime?
  hoursWorked    Float?
  otHours        Float     @default(0)
  status         AttStatus @default(PRESENT)
  notes          String?
  // Geolocation
  clockInLat     Float?
  clockInLng     Float?
  clockOutLat    Float?
  clockOutLng    Float?
  withinGeofence Boolean?
  locationName   String?   // name of the matched location
  // ── TAT-005 scheduled-time reconciliation ────────────────────────────────
  // Captured from the matching RosterEntry → Shift{Template,WorkingShift} at
  // clock-in / clock-out time. If the employee has no roster entry for the
  // date, scheduledStart/End stay null and both delta statuses are NOT_APPLICABLE.
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  // Minutes the employee clocked in BEFORE scheduledStart, or clocked out
  // AFTER scheduledEnd. Always non-negative — short hours (clocking in late
  // or out early) count automatically against the employee and are not
  // captured here.
  earlyMinutes      Int          @default(0)
  lateMinutes       Int          @default(0)
  // Per-side delta status. AUTO_APPROVED = within shift grace; PENDING =
  // outside grace, manager review required; APPROVED/DENIED = manager
  // decision; NOT_APPLICABLE = no delta on that side.
  earlyStatus       DeltaStatus  @default(NOT_APPLICABLE)
  lateStatus        DeltaStatus  @default(NOT_APPLICABLE)
  earlyApprovedBy   String?
  earlyApprovedAt   DateTime?
  earlyDenyReason   String?
  lateApprovedBy    String?
  lateApprovedAt    DateTime?
  lateDenyReason    String?
  // Billable hours after clipping unapproved early/late time to scheduled
  // bounds. Recomputed by the reconciliation engine on every status change.
  // Payroll auto-feed reads these (NOT raw hoursWorked / otHours).
  billableHours     Float?
  billableOtHours   Float        @default(0)
  createdAt         DateTime     @default(now())

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([earlyStatus])
  @@index([lateStatus])
  @@index([tenantId])
  @@map("attendance_records")
}

enum DeltaStatus {
  NOT_APPLICABLE
  AUTO_APPROVED
  PENDING
  APPROVED
  DENIED
}

model WorkLocation {
  id             String    @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  name           String
  postalCode     String
  address        String
  latitude       Float
  longitude      Float
  radiusMetres   Int       @default(200)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employeeLocations EmployeeWorkLocation[]

  @@index([tenantId])
  @@map("work_locations")
}

model EmployeeWorkLocation {
  id             String       @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId     String
  workLocationId String
  workLocation   WorkLocation @relation(fields: [workLocationId], references: [id], onDelete: Cascade)
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([employeeId, workLocationId])
  @@index([employeeId])
  @@index([tenantId])
  @@map("employee_work_locations")
}

model ShiftTemplate {
  id                String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  name              String
  startTime         String   // HH:mm
  endTime           String   // HH:mm
  breakMinutes      Int      @default(60)
  hoursPerDay       Float    @default(8)
  color             String   @default("#6366f1") // hex colour for calendar display
  // TAT-005: time within ± grace of scheduled bounds is auto-approved (no
  // manager workflow). Default 15 min each side — tunable per shift.
  graceMinutesEarly Int      @default(15)
  graceMinutesLate  Int      @default(15)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  rosterEntries RosterEntry[]
  @@index([tenantId])
  @@map("shift_templates")
}

model Schedule {
  id              String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId      String
  shiftTemplateId String
  startDate       DateTime
  endDate         DateTime?
  createdAt       DateTime @default(now())

  @@index([employeeId])
  @@index([tenantId])
  @@map("schedules")
}

model RosterEntry {
  id              String    @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId      String
  shiftTemplateId String?
  workingShiftId  String?
  shiftPatternId  String?
  date            DateTime  @db.Date
  locationId      String?
  note            String?
  publishedAt     DateTime?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shiftTemplate   ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id])
  workingShift    WorkingShift?  @relation(fields: [workingShiftId], references: [id], onDelete: SetNull)
  shiftPattern    ShiftPattern?  @relation(fields: [shiftPatternId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date])
  @@index([tenantId])
  @@map("roster_entries")
}

model ShiftProject {
  id            String        @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  name          String
  description   String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workingShifts WorkingShift[]
  shiftPatterns ShiftPattern[]
  members       ProjectMember[]

  @@index([tenantId])
  @@map("shift_projects")
}

model WorkingShift {
  id                String    @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  projectId         String
  name              String
  workMon           Boolean   @default(false)
  workTue           Boolean   @default(false)
  workWed           Boolean   @default(false)
  workThu           Boolean   @default(false)
  workFri           Boolean   @default(false)
  workSat           Boolean   @default(false)
  workSun           Boolean   @default(false)
  startTime         String
  endTime           String
  breakMinutes      Int       @default(60)
  hoursPerDay       Float     @default(8)
  color             String    @default("#6366f1")
  // TAT-005: per-shift grace window — see ShiftTemplate.graceMinutesEarly.
  graceMinutesEarly Int       @default(15)
  graceMinutesLate  Int       @default(15)
  isRecurring       Boolean   @default(true)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project        ShiftProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignments    ShiftAssignment[]
  rosterEntries  RosterEntry[]
  projectMembers ProjectMember[]

  @@index([projectId])
  @@index([tenantId])
  @@map("working_shifts")
}

model ShiftPattern {
  id            String    @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  projectId     String
  name          String
  patternType   String    @default("CUSTOM")
  workDays      Int       @default(5)
  offDays       Int       @default(2)
  startTime     String
  endTime       String
  breakMinutes  Int       @default(60)
  hoursPerShift Float     @default(8)
  color         String    @default("#6366f1")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project        ShiftProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignments    ShiftAssignment[]
  projectMembers ProjectMember[]
  rosterEntries  RosterEntry[]

  @@index([projectId])
  @@index([tenantId])
  @@map("shift_patterns")
}

model ProjectMember {
  id             String        @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  projectId      String
  employeeId     String
  workingShiftId String?
  shiftPatternId String?
  startDate      DateTime      @db.Date
  createdAt      DateTime      @default(now())

  project        ShiftProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workingShift   WorkingShift? @relation(fields: [workingShiftId], references: [id], onDelete: SetNull)
  shiftPattern   ShiftPattern? @relation(fields: [shiftPatternId], references: [id], onDelete: SetNull)

  @@unique([projectId, employeeId])
  @@index([projectId])
  @@index([tenantId])
  @@map("project_members")
}

model ShiftAssignment {
  id             String        @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId     String
  workingShiftId String?
  shiftPatternId String?
  startDate      DateTime      @db.Date
  endDate        DateTime?     @db.Date
  createdAt      DateTime      @default(now())

  workingShift   WorkingShift? @relation(fields: [workingShiftId], references: [id], onDelete: Cascade)
  shiftPattern   ShiftPattern? @relation(fields: [shiftPatternId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([tenantId])
  @@map("shift_assignments")
}

model AuditLog {
  id            String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  entityType    String
  entityId      String?
  entityName    String?
  action        String
  actorId       String?
  actorEmail    String?
  actorRole     String?
  changedFields Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([entityType])
  @@index([createdAt])
  @@index([tenantId])
  @@map("attendance_audit_logs")
}

enum AttStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  PUBLIC_HOLIDAY
}

// TAT-005: Attendance period lock + HR approval gate.
// One row per "YYYY-MM" period. Drives the payroll auto-feed handshake.
// Lifecycle: OPEN → LOCKED → APPROVED_FOR_PAYROLL. Unlocking goes back to OPEN.
model AttendancePeriod {
  id          String         @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  period      String         @unique          // "YYYY-MM"
  status      PeriodStatus   @default(OPEN)
  lockedBy    String?
  lockedAt    DateTime?
  approvedBy  String?
  approvedAt  DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([tenantId])
  @@map("attendance_periods")
}

enum PeriodStatus {
  OPEN
  LOCKED
  APPROVED_FOR_PAYROLL
}

// TAT-004: attendance anomaly ledger.
// One row per (employee, date, type) — daily sweep upserts on the natural key
// so re-runs don't fan out duplicates. Manager workflow flips status through
// PENDING → ACKNOWLEDGED / EXPLAINED / DISMISSED.
model AttendanceAnomaly {
  id            String           @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId    String
  date          DateTime         @db.Date
  type          AnomalyType
  severity      AnomalySeverity  @default(LOW)
  message       String
  detail        Json?
  status        AnomalyStatus    @default(PENDING)
  // Optional link back to the AttendanceRecord row that triggered it. Null
  // when there is no record (AWOL) or when the anomaly aggregates many rows
  // (MONTHLY_OT_BREACH).
  recordId      String?
  // Manager workflow
  acknowledgedBy   String?
  acknowledgedAt   DateTime?
  explanation      String?
  explanationBy    String?
  explanationAt    DateTime?
  dismissedBy      String?
  dismissedAt      DateTime?
  dismissReason    String?
  // Bookkeeping
  detectedAt    DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([employeeId, date, type])
  @@index([status])
  @@index([type])
  @@index([employeeId])
  @@index([date])
  @@index([tenantId])
  @@map("attendance_anomalies")
}

enum AnomalyType {
  LATE_ARRIVAL
  EARLY_DEPARTURE
  MISSING_CLOCK_OUT
  AWOL
  EXCESSIVE_OT
  MONTHLY_OT_BREACH
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
}

enum AnomalyStatus {
  PENDING
  ACKNOWLEDGED
  EXPLAINED
  DISMISSED
}

// TAT-004: org-wide configurable thresholds. Singleton (id=1) — POST upserts.
// Values mirror DEFAULT_THRESHOLDS in anomaly.engine.js; the engine reads
// these via the sweep route and falls back to defaults when no row exists.
model AnomalyThreshold {
  id                          Int       @id @default(1)
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  lateThresholdMin            Int       @default(15)
  earlyDepartThresholdMin     Int       @default(15)
  dailyOtThresholdHours       Float     @default(4)
  monthlyOtAlertHours         Float     @default(60)
  missingClockOutGraceHours   Float     @default(2)
  updatedBy                   String?
  updatedAt                   DateTime  @updatedAt
  createdAt                   DateTime  @default(now())

  @@index([tenantId])
  @@map("anomaly_thresholds")
}

// ── FWA-001: Flexi-Work Arrangements (MOM Dec 2024 mandate) ──────────────────
// Employees submit FWA requests; managers/HR must respond within 2 months.
// Non-response past the deadline auto-flags as EXPIRED via daily sweep.

model FwaRequest {
  id              String    @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId      String
  type            FwaType
  status          FwaStatus @default(PENDING)
  proposedStart   DateTime                      // when FWA takes effect
  proposedEnd     DateTime?                     // null = open-ended / permanent
  reason          String
  details         Json?                         // type-specific config (see FwaType notes)
  reviewedById    String?
  reviewedAt      DateTime?
  reviewDeadline  DateTime                      // proposedStart date + 2 months (MOM)
  decisionNote    String?                       // written decision per MOM requirement
  notifiedAt      DateTime?                     // when employee was notified of decision
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([reviewDeadline])
  @@index([tenantId])
  @@map("fwa_requests")
}

// FwaType details (stored in `details` JSON):
// FLEXI_TIME  → { proposedStartTime: "09:00", proposedEndTime: "18:00", daysApplied: ["MON","TUE","WED","THU","FRI"] }
// FLEXI_LOAD  → { hoursPerWeek: 32, daysPerWeek: 4, reducedDays: ["FRI"] }
// FLEXI_PLACE → { wfhDaysPerWeek: 3, wfhDays: ["MON","WED","FRI"], primaryLocation: "Home" }
enum FwaType {
  FLEXI_TIME   // flexible start/end hours
  FLEXI_LOAD   // reduced hours or days
  FLEXI_PLACE  // work-from-home / remote
}

enum FwaStatus {
  PENDING     // awaiting manager/HR response (within 2 months)
  APPROVED    // FWA granted
  REJECTED    // declined (decisionNote mandatory)
  WITHDRAWN   // employee withdrew before decision
  EXPIRED     // no response within 2-month deadline (MOM violation)
}

// ── FWA-002: OT Pre-Authorization Workflow (MOM EA s.38 — 72h/month cap) ──────
// Employees or supervisors request OT pre-authorization before OT is worked.
// Emergency OT may be authorized post-hoc within 24 hours.
// Approved hours are tracked against MOM 72h monthly cap and dept budget.

model OtAuthorization {
  id                    String        @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId            String
  departmentId          String?
  requestedById         String        // who submitted (employee or supervisor)
  requestType           OtRequestType @default(EMPLOYEE)
  isEmergency           Boolean       @default(false)
  requestedHours        Float
  plannedDate           DateTime      @db.Date
  reason                String
  businessJustification String?
  status                OtAuthStatus  @default(PENDING)
  reviewedById          String?
  reviewedAt            DateTime?
  decisionNote          String?
  linkedRecordId        String?       // AttendanceRecord.id once OT is worked
  expiresAt             DateTime      // PENDING expires at plannedDate (or +24h for emergency)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([plannedDate])
  @@index([departmentId])
  @@index([tenantId])
  @@map("ot_authorizations")
}

enum OtAuthStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  AUTO_EXPIRED
}

enum OtRequestType {
  EMPLOYEE
  SUPERVISOR
}

// OT budget per department per calendar month. Approved hours are incremented
// on each approval; usedHours tracks actuals fed from attendance records.
model OtBudget {
  id           String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  departmentId String
  period       String   // YYYY-MM
  budgetHours  Float
  usedHours    Float    @default(0)
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([departmentId, period])
  @@index([period])
  @@index([tenantId])
  @@map("ot_budgets")
}

// ── FWA-003: WICA Work Injury Compensation Act 2019 ───────────────────────────
// Employers must report to MOM via iReport: fatal within 1 working day,
// hospitalisation/permanent incapacity within 10 working days.
// Medical-leave-only incidents do not require MOM reporting (keep 3-year records).

model WicaIncident {
  id                String        @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId        String
  reportedById      String        // employee or supervisor who submitted the report
  incidentDate      DateTime      @db.Date
  incidentTime      String?       // HH:mm (local time at incident)
  incidentLocation  String
  description       String
  category          WicaCategory
  injuryType        String?       // e.g., "Laceration", "Fracture"
  bodyPart          String?       // e.g., "Right hand"
  status            WicaStatus    @default(REPORTED)
  momReportDeadline DateTime?     // null for MEDICAL_LEAVE_ONLY (not reportable)
  momReportedAt     DateTime?
  ireportRef        String?       // MOM iReport reference number
  closedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  claims WicaClaim[]
  rtw    WicaRtwRecord[]

  @@index([employeeId])
  @@index([status])
  @@index([category])
  @@index([momReportDeadline])
  @@index([tenantId])
  @@map("wica_incidents")
}

enum WicaCategory {
  MEDICAL_LEAVE_ONLY    // < 3 days MC; no MOM reporting required
  HOSPITALISATION       // hospital admission; report within 10 working days
  PERMANENT_INCAPACITY  // partial or total; report within 10 working days
  FATAL                 // death; report within 1 working day
}

enum WicaStatus {
  REPORTED        // logged, awaiting review
  UNDER_REVIEW    // HR/safety officer reviewing
  MOM_REPORTED    // submitted via iReport; ireportRef captured
  CLAIM_SUBMITTED // WICA claim filed with insurer
  CLOSED          // incident resolved
}

model WicaClaim {
  id                      String      @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  incidentId              String
  employeeId              String
  medicalExpenses         Float?
  medicalLeaveDays        Int?
  hospitalLeaveDays       Int?
  permanentIncapacityPct  Float?      // 0–100%
  compensationAmount      Float?      // computed or agreed
  insurerName             String?
  insurerPolicyNo         String?
  claimRef                String?     // insurer's claim reference
  status                  ClaimStatus @default(PENDING)
  assessedBy              String?
  assessedAt              DateTime?
  approvedBy              String?
  approvedAt              DateTime?
  paidAt                  DateTime?
  rejectionReason         String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  incident WicaIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([status])
  @@index([employeeId])
  @@index([tenantId])
  @@map("wica_claims")
}

enum ClaimStatus {
  PENDING
  INSURER_NOTIFIED
  UNDER_ASSESSMENT
  APPROVED
  PAID
  REJECTED
}

// Return-to-work record — tracks employee's gradual return after injury
model WicaRtwRecord {
  id          String    @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  incidentId  String
  employeeId  String
  rtwDate     DateTime  @db.Date
  rtwType     RtwType
  restrictions String?  // free-text medical restrictions
  reviewDate  DateTime? @db.Date  // next scheduled review
  clearedAt   DateTime? // cleared for full duties
  createdBy   String?
  createdAt   DateTime  @default(now())

  incident WicaIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([employeeId])
  @@index([tenantId])
  @@map("wica_rtw_records")
}

enum RtwType {
  FULL_DUTIES
  LIGHT_DUTIES
  PHASED_RETURN
}
