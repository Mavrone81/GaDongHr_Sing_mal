{
  "name": "@hrms/employee-service",
  "version": "1.0.0",
  "description": "GaDongHR Employee Lifecycle Service",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand --forceExit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.js"],
    "moduleNameMapper": {
      "/app/shared/auth-middleware": "<rootDir>/__mocks__/auth-middleware.js",
      "/app/shared/crypto": "<rootDir>/__mocks__/crypto.js",
      "/app/shared/tenant-context": "<rootDir>/../../shared/tenant-context/index.js",
      "/app/shared/(.*)": "<rootDir>/__mocks__/generic.js"
    }
  }
}
