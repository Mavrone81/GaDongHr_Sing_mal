// Prisma schema for employee-service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApprovalFlowType {
  ANY_ONE
  SEQUENTIAL
}

model EmployeeSupervisor {
  id                    String   @id @default(uuid())
  employeeId            String
  supervisorEmployeeId  String
  order                 Int      @default(0)
  createdAt             DateTime @default(now())

  employee   Employee @relation("EmployeeSupervisors", fields: [employeeId], references: [id], onDelete: Cascade)
  supervisor Employee @relation("SupervisorOf", fields: [supervisorEmployeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, supervisorEmployeeId])
  @@index([employeeId])
  @@index([supervisorEmployeeId])
  @@map("employee_supervisors")
}

model Employee {
  id                  String    @id @default(uuid())
  employeeCode        String    @unique // e.g. EMP-0001
  fullName            String
  preferredName       String?
  nricEncrypted       String?   // AES-256-GCM encrypted NRIC/FIN
  nricType            NricType  @default(NRIC)  // NRIC | FIN
  nationality         String?
  citizenshipStatus   CitizenStatus @default(SC)
  dateOfBirth         DateTime?
  gender              Gender?
  race                String?
  religion            String?
  maritalStatus       MaritalStatus @default(SINGLE)

  // Contact
  personalEmail       String?
  workEmail           String
  personalPhone       String?
  workPhone           String?
  homeAddressEncrypted String?   // encrypted

  // Employment
  department          String
  designation         String
  costCentre          String?
  employmentType      EmploymentType @default(FULL_TIME)
  startDate           DateTime
  confirmationDate    DateTime?
  endDate             DateTime?
  reportingManagerId  String?
  probationEndDate    DateTime?
  noticePeriodDays    Int       @default(30)
  weeklyHours         Float     @default(44)  // SG standard
  isActive            Boolean   @default(true)

  // Salary (encrypted)
  basicSalaryEncrypted String?  // AES-256-GCM
  salaryBasis         SalaryBasis @default(MONTHLY)

  // Bank (encrypted)
  bankName            String?
  bankCode            String?
  bankAccountEncrypted String?  // AES-256-GCM
  bankBranchCode      String?

  // Work Pass
  passType            PassType?
  passNumber          String?
  passExpiryDate      DateTime?
  passIssuedDate      DateTime?
  workPassSector      String?  // for FWL computation

  // CPF
  cpfPrYear           Int?     // 1, 2, 3+ for Graduated PR
  cpfVoluntaryRate    Boolean  @default(false)

  profilePhotoUrl     String?  // base64 data URL for face verification
  approvalFlowType    ApprovalFlowType @default(ANY_ONE)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  documents           Document[]
  salaryHistory       SalaryHistory[]
  emergencyContacts   EmergencyContact[]
  supervisors         EmployeeSupervisor[] @relation("EmployeeSupervisors")
  supervising         EmployeeSupervisor[] @relation("SupervisorOf")

  @@index([department])
  @@index([isActive])
  @@map("employees")
}

model SalaryHistory {
  id                String    @id @default(uuid())
  employeeId        String
  effectiveDate     DateTime
  basicSalaryEnc    String    // encrypted — legacy alias for previousSalaryEnc
  previousSalaryEnc String?   // encrypted salary BEFORE this revision
  newSalaryEnc      String?   // encrypted salary AFTER this revision
  changeReason      String?   // legacy free-text
  reasonCode        String    @default("OTHER") // PROMOTION|ANNUAL_INCREMENT|MARKET_ADJUSTMENT|ROLE_CHANGE|CORRECTION|OTHER
  recommendedBy     String?   // name/email of person recommending the change
  notes             String?
  changedByUserId   String?   // userId who initiated
  approvedBy        String?   // userId who approved
  approvedAt        DateTime?
  status            String    @default("APPROVED") // PENDING|APPROVED|REJECTED
  catchUpAmount     Float?    // back-dated catch-up amount (SGD), computed on approve
  createdAt         DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@map("salary_history")
}

model Document {
  id          String   @id @default(uuid())
  employeeId  String
  docType     String   // NRIC_COPY | EMPLOYMENT_PASS | CONTRACT | CERT | OTHER
  fileName    String
  filePath    String
  fileSize    Int?
  mimeType    String?
  uploadedBy  String
  expiryDate  DateTime?
  createdAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("documents")
}

model EmergencyContact {
  id           String  @id @default(uuid())
  employeeId   String
  name         String
  relationship String
  phone        String
  email        String?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("emergency_contacts")
}

model AuditLog {
  id            String   @id @default(uuid())
  entityType    String   // 'Employee'
  entityId      String   // employee UUID
  entityCode    String?  // EMP-0001 for quick display
  entityName    String?  // employee full name at time of change
  action        String   // CREATE | UPDATE | DELETE | VIEW_SENSITIVE
  actorId       String?
  actorEmail    String?
  actorRole     String?
  changedFields Json?    // { field: { from, to } } — sensitive fields noted but not stored
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([entityId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

enum NricType {
  NRIC
  FIN
}
enum CitizenStatus {
  SC
  PR_YEAR1
  PR_YEAR2
  PR_YR3_PLUS
  FOREIGNER
}
enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}
enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMP
}
enum SalaryBasis {
  MONTHLY
  DAILY
  HOURLY
  PIECE_RATE
}
enum PassType {
  EP
  SP
  WP
  S_PASS
  LTVP
  DEPENDANT_PASS
}

model EmployeeApplication {
  id              String   @id @default(uuid())
  userId          String   @unique
  email           String
  fullName        String
  preferredName   String?
  gender          String?
  dateOfBirth     String?
  nationality     String?
  nricFin         String?
  personalPhone   String?
  homeAddress     String?
  department      String?
  designation     String?
  employmentType  String?
  startDate       String?
  bankName        String?
  bankAccount     String?
  notes           String?
  status          AppStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@map("employee_applications")
}

enum AppStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── ESV-001: Staff Movement & Internal Transfer ───────────────────────────────
// Tracks every internal transfer / role change with before/after snapshots,
// HR approval, effective-date application, and an audit-grade history per employee.

model StaffMovement {
  id                  String          @id @default(uuid())
  movementNumber      String          @unique  // e.g. MOV-2026-00001
  employeeId          String
  employeeName        String
  type                MovementType
  status              MovementStatus  @default(PENDING)

  // Before/after snapshot (taken at initiation; applied on effective date)
  fromDepartment      String
  toDepartment        String
  fromDesignation     String
  toDesignation       String
  fromCostCentre      String?
  toCostCentre        String?
  fromLocation        String?
  toLocation          String?
  fromReportingManagerId String?
  toReportingManagerId   String?
  fromCompany         String?
  toCompany           String?
  fromEmploymentType  EmploymentType?
  toEmploymentType    EmploymentType?

  // Salary revision linkage (encrypted)
  hasSalaryRevision   Boolean         @default(false)
  fromSalaryEnc       String?         // AES-256-GCM
  toSalaryEnc         String?         // AES-256-GCM
  salaryReasonCode    String?         // PROMOTION | ROLE_CHANGE | MARKET_ADJUSTMENT | OTHER

  reason              String          // free-text justification
  effectiveDate       DateTime
  initiatedBy         String          // user id of initiator
  initiatedByName     String?
  initiatedByRole     String?         // EMPLOYEE | LINE_MANAGER | HR_ADMIN | ...
  approvedBy          String?
  approvedByName      String?
  approvedAt          DateTime?
  rejectedBy          String?
  rejectedAt          DateTime?
  rejectionReason     String?
  cancelledAt         DateTime?
  appliedAt           DateTime?       // when the change was actually applied to employee record
  applyError          String?         // captures failure reason if effective-apply fails

  letterHtml          String?         // generated transfer letter (HTML)
  letterGeneratedAt   DateTime?
  esignRequestId      String?         // optional link to ESV-003 e-sign

  notifiedIt          Boolean         @default(false)
  notifiedPayroll     Boolean         @default(false)
  notifiedOldManager  Boolean         @default(false)
  notifiedNewManager  Boolean         @default(false)

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([employeeId, effectiveDate])
  @@index([status])
  @@index([effectiveDate])
  @@map("staff_movements")
}

enum MovementType {
  DEPARTMENT_TRANSFER
  LOCATION_TRANSFER
  INTER_COMPANY_TRANSFER
  ROLE_CHANGE
  PROMOTION
  REPORTING_CHANGE
  COST_CENTRE_REALLOC
}

enum MovementStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  APPLIED       // effective date passed and snapshot applied to employee record
}
