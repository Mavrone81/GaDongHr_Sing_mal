// Prisma schema for payroll-service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  entityType  String   // e.g. 'PayrollRun'
  entityId    String?  // run UUID
  action      String   // e.g. 'COMPUTE_ATTENDANCE_WARNING'
  actorId     String?
  actorEmail  String?
  actorRole   String?
  details     Json?    // arbitrary payload (warning body, period status, lockedBy, etc.)
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@index([tenantId])
  @@map("payroll_audit_logs")
}

model PayrollRun {
  id              String        @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  // ENT-001 — the entity this run belongs to, so the run has exactly one
  // country, currency and statutory rule set. Nullable for `db push` against
  // existing rows; scripts/migrate-legal-entities.js backfills it.
  legalEntityId   String?
  country         String?       // denormalised from the entity, for reporting
  currency        String?       // denormalised from the entity
  rateVersion     String?       // ENT-006 — statutory rate version used to compute
  period          String        // e.g. "2025-01"
  runType         RunType       @default(MONTHLY)
  // NONE for every non-bimonthly run. Non-nullable so it can participate in the
  // unique key below — as NULL it could not, and duplicate monthly runs slipped
  // through the database entirely.
  periodHalf      PeriodHalf    @default(NONE)
  status          RunStatus     @default(DRAFT)
  employeeGroup   String?
  initiatedBy     String        // userId
  approvedBy      String?       // userId (checker — must be different from initiatedBy; DB CHECK enforced)
  approvedAt      DateTime?
  finalisedAt     DateTime?
  paymentDate     DateTime?     // PAY-005: the date salary must be credited by (MOM EA s.21: within 7 days of period end)
  totalGross      String?       // encrypted
  totalNet        String?       // encrypted
  totalCpf        String?       // encrypted
  totalEmployerCpf String?      // encrypted
  totalSdl        String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lineItems       PayrollLineItem[]
  payslips        Payslip[]

  // Was [period, runType, periodHalf] — no tenant dimension, so two tenants
  // could not both run the same BIMONTHLY period (the second got a P2002
  // reported as "run already exists"). legalEntityId is in the key because a
  // group tenant runs one payroll per entity per period.
  //
  // periodHalf is non-nullable (NONE sentinel) precisely so this key works for
  // MONTHLY/ADHOC runs. While it was nullable the key constrained nothing for
  // them — Postgres treats every NULL as distinct — and duplicate monthly
  // payroll was possible at the database level.
  @@unique([tenantId, legalEntityId, period, runType, periodHalf])
  @@index([period])
  @@index([tenantId])
  @@index([legalEntityId])
  @@map("payroll_runs")
}

model PayrollLineItem {
  id              String    @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  runId           String
  employeeId      String
  componentId     String
  description     String
  amountEncrypted String    // AES-256-GCM
  wageType        WageType  @default(OW)
  isCpfApplicable Boolean   @default(true)
  isIrasTaxable   Boolean   @default(true)
  createdAt       DateTime  @default(now())

  run PayrollRun @relation(fields: [runId], references: [id])

  @@index([runId])
  @@index([employeeId])
  @@index([tenantId])
  @@map("payroll_line_items")
}

model Payslip {
  id                  String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  runId               String
  employeeId          String
  period              String
  // All money fields encrypted
  basicSalaryEnc      String
  grossPayEnc         String
  netPayEnc           String
  employeeCpfEnc      String
  employerCpfEnc      String
  sdlAmountEnc        String?
  fwlAmountEnc        String?
  ytdGrossEnc         String?
  ytdEmployeeCpfEnc   String?
  ytdEmployerCpfEnc   String?
  pdfPath             String?
  isPublished         Boolean  @default(false)
  publishedAt         DateTime?  // PAY-005: timestamp of publication for SLA tracking + archive
  notifiedAt          DateTime?  // PAY-005: when employee notification was fired (null = not yet)
  // No-Pay Leave auto-computed fields
  nplDays             Float?   // NPL days in this pay period (auto from leave service)
  nplDeductionEnc     String?  // encrypted NPL deduction amount
  // Government-paid leave auto-computed fields
  govtPaidDays        Float?   // govt-reimbursable leave days in period
  govtPaidAmountEnc   String?  // encrypted govt-paid amount (for employer claim)
  createdAt           DateTime @default(now())

  run PayrollRun @relation(fields: [runId], references: [id])

  @@unique([runId, employeeId])
  @@index([employeeId, period])
  @@index([publishedAt])
  @@index([tenantId])
  @@map("payslips")
}

// PAY-005: SLA alert ledger. Sweep fires when paymentDate ≤ today and the
// payslip is still unpublished (or published > paymentDate). Idempotent via
// unique (runId, type) — one row per run per SLA type, refreshable.
model PayslipSlaAlert {
  id          String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  runId       String
  period      String
  type        SlaAlertType
  severity    String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  daysOverdue Int      @default(0)
  unpublishedCount Int @default(0)
  message     String
  notifiedAt  DateTime @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([runId, type])
  @@index([type])
  @@index([resolvedAt])
  @@index([tenantId])
  @@map("payslip_sla_alerts")
}

enum SlaAlertType {
  UNPUBLISHED_PAST_PAYMENT  // run paymentDate has passed and payslips not all published
  LATE_PUBLICATION          // published, but after paymentDate
  PAYMENT_DATE_APPROACHING  // paymentDate within 2 days, run not yet finalised
}

// PAY-007: CPF / IRAS submission tracking ledger.
// One row per filing event. Caller records when a file is generated, then
// later marks SUBMITTED with the IRAS/CPF confirmation reference number,
// then ACKNOWLEDGED (or REJECTED with reason). Deadline is auto-computed
// from kind + period/year on create; daily sweep flags overdue rows.
model IrasSubmission {
  id              String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  kind            IrasSubmissionKind
  // One of period (YYYY-MM) for monthly CPF, year (Int) for annual IRAS, or
  // employeeId for IR21. The combination of (kind + the relevant scope) is
  // unique so re-recording the same filing updates rather than duplicates.
  period          String?
  year            Int?
  employeeId      String?
  runId           String?
  fileName        String?
  fileHash        String?            // SHA-256 of the generated artefact (caller computes)
  fileSize        Int?
  status          IrasSubmissionStatus @default(DRAFT)
  referenceNumber String?            // IRAS / CPF Board confirmation reference
  submittedBy     String?
  submittedAt     DateTime?
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  rejectedReason  String?
  rejectedAt      DateTime?
  deadline        DateTime?          // computed on create; null if caller skips
  notes           String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([kind])
  @@index([status])
  @@index([deadline])
  @@index([year])
  @@index([period])
  @@index([tenantId])
  @@map("iras_submissions")
}

enum IrasSubmissionKind {
  CPF_E_SUBMIT       // monthly CPF — period = "YYYY-MM"
  IR8A               // annual employment income — year required
  APPENDIX_8A        // annual benefits-in-kind — year required
  APPENDIX_8B        // annual stock options — year required
  IR21               // tax clearance for foreign employee — employeeId required
}

enum IrasSubmissionStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
  REJECTED
}

model PayComponent {
  id              String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  code            String   // e.g. "BASIC", "OT_PAY", "AWS"
  name            String
  category        String   // ORDINARY_WAGES | ALLOWANCE | OT | ADDITIONAL_WAGES | DEDUCTION | REIMBURSEMENT
  isCpfApplicable Boolean  @default(true)
  isIrasTaxable   Boolean  @default(true)
  wageType        WageType @default(OW)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("pay_components")
}

model CpfRate {
  id               String      @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  citizenStatus    String      // SC_PR | PR_YEAR1 | PR_YEAR2 | FOREIGNER
  ageMin           Int
  ageMax           Int?        // null = no upper bound
  employeeRate     Float       // e.g. 0.20
  employerRate     Float       // e.g. 0.17
  effectiveDate    DateTime
  owCeiling        Float       @default(6800)
  awCeiling        Float       @default(102000)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())

  @@index([tenantId])
  @@map("cpf_rates")
}

model SdlConfig {
  id            String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  rate          Float    @default(0.0025) // 0.25%
  minAmount     Float    @default(2.00)
  maxAmount     Float    @default(11.25)
  salaryCap     Float    @default(4500)
  effectiveDate DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@map("sdl_config")
}

model FwlRate {
  id           String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  passType     String   // WP | S_PASS
  sector       String   // SERVICES | CONSTRUCTION | MARINE | PROCESS | MANUFACTURING
  tier         String   // BASIC_SKILLED | HIGHER_SKILLED | TIER1 | TIER2
  dailyRate    Float
  effectiveDate DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@map("fwl_rates")
}

// ─── PAY-004: DRC (Dependency Ratio Ceiling) quota configuration ─────────────
model DrcQuota {
  id             String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  sector         String   // SERVICES | CONSTRUCTION | MARINE | PROCESS | MANUFACTURING
  passType       String   // WP | S_PASS
  maxRatioPct    Float    // e.g. 15.0 = 15%
  alertThreshPct Float    @default(80.0) // alert when usage >= this % of ceiling
  isActive       Boolean  @default(true)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  // Was [sector, passType] — same missing-tenant defect as PayrollRun had.
  // (This table moves to statutory-sg-service in Task 10; scoped correctly
  // here so the interim state is sound rather than knowingly broken.)
  @@unique([tenantId, sector, passType])
  @@index([tenantId])
  @@map("drc_quotas")
}

model PublicHoliday {
  id        String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  // ENT-001 — holidays belong to the jurisdiction an entity operates in, not to
  // the tenant. Nullable for `db push` against existing rows;
  // scripts/migrate-legal-entities.js backfills it.
  legalEntityId String?
  country   String?  // denormalised from the entity, for reporting
  state     String?  // MY only — federal holidays plus the state's own set
  date      DateTime
  name      String
  year      Int
  createdAt DateTime @default(now())

  // Was [tenantId, date], which allowed a tenant only ONE holiday per calendar
  // date and so blocked multi-entity outright: a group tenant could not hold
  // both Labour Day (SG) and Hari Pekerja (MY) on 1 May, nor differ on any
  // other date. Scoped per entity now.
  @@unique([tenantId, legalEntityId, date])
  @@index([tenantId])
  @@index([legalEntityId])
  @@map("public_holidays")
}

model PayrollPeriodConfig {
  id          String      @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  period      String          // "YYYY-MM"
  workDayType WorkDayType @default(FIVE_DAY)
  workingDays Int?                   // null = auto-computed from public holidays
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([tenantId, period])
  @@index([tenantId])
  @@map("payroll_period_configs")
}

// ─── Benefits-in-Kind (IRAS Appendix 8A) ──────────────────────────────────────
// Tracks non-cash benefits per employee per tax year. Annual taxable value is
// computed (IRAS formula) or entered (manual) and surfaced in IR8A + Appendix 8A.
model BikItem {
  id                String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId        String
  year              Int                          // tax year
  bikType           BikType                      // COMPANY_CAR | HOUSING | CLUB | GROUP_INSURANCE | OTHER
  description       String?
  // Company car inputs
  engineCapacity    Int?                         // cc
  carPurchaseCost   Float?
  employerProvidesFuel Boolean @default(false)
  runningCost       Float?                       // annual running cost (fuel/maintenance)
  // Housing inputs
  housingAnnualValue Float?                      // IRAS-assessed AV
  // Final computed taxable benefit (encrypted)
  annualValueEnc    String                       // SGD per year
  computationMethod String                       // "IRAS_FORMULA" | "MANUAL"
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([employeeId, year, bikType])
  @@index([employeeId, year])
  @@index([year])
  @@index([tenantId])
  @@map("bik_items")
}

// ─── Stock Options / ESOP / ESPP (IRAS Appendix 8B) ───────────────────────────
model StockOptionGrant {
  id            String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId    String
  grantDate     DateTime
  totalShares   Int
  optionPrice   Float                            // strike price per share (SGD)
  scheme        String   @default("ESOP")        // ESOP | ESPP | RSU
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exercises StockOptionExercise[]

  @@index([employeeId])
  @@index([grantDate])
  @@index([tenantId])
  @@map("stock_option_grants")
}

model StockOptionExercise {
  id                    String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  grantId               String
  exerciseDate          DateTime
  sharesExercised       Int
  marketValueAtExercise Float                    // OMV per share at exercise (SGD)
  taxableGainEnc        String                   // encrypted: (OMV - optionPrice) × shares
  notes                 String?
  createdAt             DateTime @default(now())

  grant StockOptionGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
  @@index([exerciseDate])
  @@index([tenantId])
  @@map("stock_option_exercises")
}

enum BikType {
  COMPANY_CAR
  HOUSING
  CLUB_MEMBERSHIP
  GROUP_INSURANCE
  OTHER
}

// ─── Cost centres & payroll journal (PAY-012) ─────────────────────────────────
model CostCentre {
  id                String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  code              String
  name              String
  description       String?
  isActive          Boolean  @default(true)
  // Optional GL overrides — fall back to system defaults if null
  glSalaryAccount   String?
  glCpfAccount      String?
  glSdlAccount      String?
  glFwlAccount      String?
  glBankAccount     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  allocations EmployeeCostCentre[]
  entries     PayrollJournalEntry[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("cost_centres")
}

// One employee may be split across multiple cost centres. Percentages must sum
// to 100 at any point in time; the API enforces this on write.
model EmployeeCostCentre {
  id            String    @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId    String
  costCentreId  String
  percentage    Float
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  costCentre CostCentre @relation(fields: [costCentreId], references: [id])

  @@index([employeeId])
  @@index([costCentreId])
  @@index([tenantId])
  @@map("employee_cost_centres")
}

model PayrollJournal {
  id           String    @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  runId        String
  period       String
  generatedAt  DateTime  @default(now())
  totalDebit   Float     @default(0)
  totalCredit  Float     @default(0)
  status       String    @default("DRAFT")   // DRAFT | EXPORTED | POSTED
  exportFormat String?                       // XERO | QUICKBOOKS | SAP | CSV
  exportedAt   DateTime?

  entries PayrollJournalEntry[]

  @@unique([tenantId, runId])
  @@index([period])
  @@index([tenantId])
  @@map("payroll_journals")
}

model PayrollJournalEntry {
  id           String  @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  journalId    String
  account      String                       // e.g. "5100"
  accountName  String                       // e.g. "Salary Expense"
  side         String                       // "DEBIT" | "CREDIT"
  description  String
  amountEnc    String                       // encrypted SGD
  costCentreId String?
  employeeId   String?

  journal    PayrollJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  costCentre CostCentre?    @relation(fields: [costCentreId], references: [id])

  @@index([journalId])
  @@index([costCentreId])
  @@index([tenantId])
  @@map("payroll_journal_entries")
}

// ─── Government-Paid Leave Claims (PAY-011) ───────────────────────────────────
// One row per employee × period × leave type. Generated from approved govt-paid
// leave applications after payroll compute. Tracks reimbursement from MSF/MINDEF.
model GovtLeaveClaimPayroll {
  id                  String          @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId          String
  period              String          // YYYY-MM of the payroll period
  leaveTypeCode       String          // ML | PL | CCL | SPL | NSL
  leaveTypeName       String
  leaveDays           Float
  dailyRateEnc        String          // encrypted: civilian daily rate used
  claimableAmountEnc  String          // encrypted: min(dailyRate × days, MSF daily cap × days)
  cpfOnGovtPaidEnc    String?         // encrypted: employer CPF attributable to govt-paid days
  nsMakeupAmountEnc   String?         // encrypted: (dailyRate − nsAllowancePerDay) × days, NSL only
  nsAllowancePerDay   Float?          // MINDEF daily allowance used for NSL formula
  status              GovtClaimStatus @default(PENDING)
  submissionRef       String?
  submittedAt         DateTime?
  reimbursedAmountEnc String?         // encrypted: actual amount reimbursed
  reimbursedAt        DateTime?
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([employeeId, period, leaveTypeCode])
  @@index([period])
  @@index([employeeId])
  @@index([status])
  @@index([tenantId])
  @@map("govt_leave_claims_payroll")
}

enum GovtClaimStatus {
  PENDING
  SUBMITTED
  REIMBURSED
  REJECTED
}

enum WorkDayType {
  FIVE_DAY
  SIX_DAY
}

enum ComponentCategory {
  BASIC
  ALLOWANCE
  OT
  ADDITIONAL_WAGES
  DEDUCTION
  REIMBURSEMENT
  GOVT_PAID
  BIK
  STATUTORY
}
enum WageType {
  OW
  AW
  DEDUCTION
  REIMBURSEMENT
}
enum RunStatus {
  DRAFT
  IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
  FINALISED
  CANCELLED
}
enum RunType {
  MONTHLY
  BIMONTHLY
  ADHOC
  BONUS
  FINAL_PAY
  COMMISSION
}
enum PeriodHalf {
  FIRST
  SECOND
  // Storage sentinel for runs with no half (MONTHLY, ADHOC, BONUS, …).
  // NOT part of the API contract — callers still omit periodHalf entirely, and
  // validateRunTypeShape still rejects one on a non-bimonthly run. It exists
  // because NULL cannot participate in a unique constraint: Postgres treats
  // every NULL as distinct from every other NULL, so the run key silently
  // permitted duplicate monthly payroll.
  // See services/payroll-service/src/utils/run-scope.js.
  NONE
}

model GiroPayment {
  id           String            @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  runId        String
  employeeId   String
  employeeName String?
  bank         String            // uob | ocbc | dbs | scb | hsbc | maybank
  bankCode     String?
  bankAccount  String?
  amountEnc    String?           // encrypted net pay
  status       GiroPaymentStatus @default(PENDING)
  returnCode   String?
  returnReason String?
  generatedAt  DateTime          @default(now())
  processedAt  DateTime?

  @@index([runId])
  @@index([status])
  @@index([employeeId])
  @@index([tenantId])
  @@map("giro_payments")
}

enum GiroPaymentStatus {
  PENDING
  SENT
  RETURNED
  FAILED
}

/// ENT-006 — one row per statutory figure on a payslip, with the rate version
/// that produced it. Country-agnostic by design: CPF_EE/SDL for Singapore,
/// EPF_EE/SOCSO_ER/PCB/HRDF for Malaysia, same table.
///
/// Written ALONGSIDE the legacy SG-named columns on Payslip during the
/// transition, so existing readers (PDF, IRAS, reporting) are untouched. MY
/// runs write only these rows — "employeeCpfEnc" means nothing for EPF.
model PayslipStatutoryLine {
  id          String   @id @default(uuid())
  tenantId    String
  payslipId   String
  code        String   // CPF_EE | CPF_ER | SDL | FWL | EPF_EE | SOCSO_ER | PCB | HRDF ...
  label       String
  party       String   // EMPLOYEE | EMPLOYER
  kind        String   // DEDUCTION | CONTRIBUTION | LEVY
  amountEnc   String   // AES-256-GCM, like every other money column
  basis       Json?    // which band/rate applied — the audit trail
  rateVersion String   // ENT-006: reproducibility after the tables move on
  createdAt   DateTime @default(now())

  @@unique([payslipId, code])
  @@index([tenantId])
  @@index([payslipId])
  @@map("payslip_statutory_lines")
}
