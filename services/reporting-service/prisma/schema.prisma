generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── RPT-003 Phase 1: report builder foundation ────────────────────────────────
// A ReportTemplate is a stored, named query against one data source.
// definition (JSON) shape:
//   {
//     dataSource: "employees" | "payrollRuns" | "leaveApplications" | "attendance" | "claims",
//     fields:     [{ key: "department", label: "Dept" }, ...],
//     filters:    [{ field: "isActive", op: "eq", value: true }, ...],
//     groupBy:    "department",                       // optional
//     aggregations: [{ field: "salary", op: "sum", as: "totalSalary" }, ...],
//     sortBy:     [{ field: "department", dir: "asc" }],
//     limit:      1000
//   }
//
// definition is validated at run time by the executor — no strict prisma typing.

model ReportTemplate {
  id          String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  name        String
  description String?
  category    String?
  definition  Json
  ownerId     String
  isShared    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schedules ReportSchedule[]
  runs      ReportRun[]

  @@index([ownerId])
  @@index([category])
  @@index([tenantId])
  @@map("report_templates")
}

enum ScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ScheduleFormat {
  CSV
  XLSX
  PDF
}

enum SubmissionType {
  CPF_E_SUBMIT
  SDL_SSG
  FWL_MOM
  IR8A_IRAS
  MOM_HEADCOUNT
  ANNUAL_MANPOWER_SURVEY
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
}

model ReportSchedule {
  id          String            @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  templateId  String
  frequency   ScheduleFrequency
  format      ScheduleFormat    @default(CSV)
  recipients  String            // comma-separated emails
  isActive    Boolean           @default(true)
  nextRunAt   DateTime
  lastRunAt   DateTime?
  createdBy   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  template ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  runs     ReportRun[]

  @@index([nextRunAt, isActive])
  @@index([templateId])
  @@index([tenantId])
  @@map("report_schedules")
}

enum RunStatus {
  SUCCESS
  ERROR
}

model ReportRun {
  id          String     @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  templateId  String
  scheduleId  String?
  status      RunStatus
  rowCount    Int        @default(0)
  errorMsg    String?
  triggeredBy String     // userId or "scheduler"
  startedAt   DateTime   @default(now())
  completedAt DateTime?

  template ReportTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  schedule ReportSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([templateId, startedAt])
  @@index([tenantId])
  @@map("report_runs")
}

// ── ENG-002: HR Analytics Dashboard budget store ──────────────────────────────
// HR-set budgets per period for headcount / recruitment / revenue dashboards.
// Was an in-memory map until 2026-05-29 — restarts dropped every value.
enum BudgetCategory {
  HEADCOUNT
  RECRUITMENT
  REVENUE
}

model AnalyticsBudget {
  id        String         @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  category  BudgetCategory
  period    String         // YYYY or YYYY-MM
  value     Float
  setBy     String?        // userId
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([category, period])
  @@index([category])
  @@index([tenantId])
  @@map("analytics_budgets")
}

// ── RPT-002: Statutory submission history ─────────────────────────────────────
model StatutorySubmission {
  id              String           @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  type            SubmissionType
  period          String           // YYYY-MM or YYYY for annual
  status          SubmissionStatus @default(DRAFT)
  referenceNumber String?
  fileName        String?
  notes           String?
  submittedAt     DateTime?
  submittedBy     String?
  acknowledgedAt  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([type, period])
  @@index([status])
  @@index([tenantId])
  @@map("statutory_submissions")
}
