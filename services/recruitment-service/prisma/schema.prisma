// Prisma schema for recruitment-service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model JobPosting {
  id              String     @id @default(uuid())
  title           String
  department      String
  headcount       Int        @default(1)
  jobDescription  String
  requirements    String?
  salaryMin       Float?
  salaryMax       Float?
  jobType         String     @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT
  location        String?
  mcfJobId        String?    // MyCareersFuture reference
  mcfPostedAt     DateTime?  // when posted on MCF
  mcfExpiredAt    DateTime?  // must be 14 days before shortlisting
  fcfCompliant    Boolean    @default(false)
  status          JobStatus  @default(DRAFT)
  postedById      String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  candidates      Candidate[]

  @@map("job_postings")
}

model Candidate {
  id              String     @id @default(uuid())
  jobId           String?
  firstName       String
  lastName        String
  email           String
  phone           String?
  currentEmployer String?
  currentTitle    String?
  noticePeriod    Int?
  expectedSalary  Float?
  resumePath      String?
  resumeName      String?
  stage           PipelineStage @default(APPLIED)
  isOfferMade     Boolean    @default(false)
  isHired         Boolean    @default(false)
  employeeId      String?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  job              JobPosting?    @relation(fields: [jobId], references: [id])
  interviewRounds  InterviewRound[]
  stageEvents      CandidateStageEvent[]

  @@map("candidates")
}

model CandidateStageEvent {
  id          String   @id @default(uuid())
  candidateId String
  fromStage   String?
  toStage     String
  note        String?
  changedBy   String?
  createdAt   DateTime @default(now())

  candidate   Candidate @relation(fields: [candidateId], references: [id])

  @@index([candidateId])
  @@map("candidate_stage_events")
}

model InterviewRound {
  id            String   @id @default(uuid())
  candidateId   String
  roundName     String
  scheduledAt   DateTime
  interviewerIds String[]
  notes         String?
  result        String?  // PASS | FAIL | PENDING
  createdAt     DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@map("interview_rounds")
}

model OnboardingTask {
  id          String   @id @default(uuid())
  employeeId  String
  taskName    String
  description String?
  assignedTo  String?  // userId
  dueDate     DateTime?
  isDone      Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([employeeId])
  @@map("onboarding_tasks")
}

model WorkPass {
  id           String   @id @default(uuid())
  employeeId   String   @unique
  passType     String
  passNumber   String
  expiryDate   DateTime
  issuedDate   DateTime?
  status       String   @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED | RENEWING
  // REC-003 renewal lifecycle
  sector              String?    // for DRC quota (e.g. CONSTRUCTION, MANUFACTURING, SERVICES, MARINE, PROCESS)
  workerTier          String?    // BASIC | HIGHER (for FWL/DRC quota)
  renewalInitiatedAt  DateTime?
  renewalSubmittedAt  DateTime?
  renewalOutcome      String?    // APPROVED | REJECTED | WITHDRAWN
  renewalOutcomeAt    DateTime?
  renewalReference    String?    // MOM reference
  renewalNotes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  alerts       WorkPassAlert[]
  checklistItems WorkPassRenewalChecklist[]

  @@map("work_passes")
}

// REC-003: idempotent alert ledger for work-pass expiry. One row per
// (workPassId, threshold) — daily sweep upserts so re-runs don't fan out
// duplicate notifications.
model WorkPassAlert {
  id          String   @id @default(uuid())
  workPassId  String
  employeeId  String   // denormalised for fast dashboard queries
  passType    String
  threshold   Int      // 90 | 60 | 30 | 0 (0 = expired)
  expiryDate  DateTime
  message     String
  notifiedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  workPass    WorkPass @relation(fields: [workPassId], references: [id], onDelete: Cascade)

  @@unique([workPassId, threshold])
  @@index([employeeId])
  @@index([expiryDate])
  @@map("work_pass_alerts")
}

// REC-003: per-pass-type renewal checklist items. HR ticks each off.
model WorkPassRenewalChecklist {
  id          String   @id @default(uuid())
  workPassId  String
  itemName    String
  isComplete  Boolean  @default(false)
  completedAt DateTime?
  completedBy String?
  notes       String?
  createdAt   DateTime @default(now())

  workPass    WorkPass @relation(fields: [workPassId], references: [id], onDelete: Cascade)

  @@index([workPassId])
  @@map("work_pass_renewal_checklist")
}

// REC-003: DRC quota configuration per sector × worker tier.
// MOM sets the maximum ratio of S-Pass + Work Permit holders to total
// workforce per sector. ratioLimit is the ceiling; alertThreshold is the
// "approaching cap" warn level (e.g. 0.85 = warn at 85% of cap).
model DrcQuotaConfig {
  id              String   @id @default(uuid())
  sector          String
  workerTier      String   @default("BASIC")  // BASIC | HIGHER
  ratioLimit      Float    // e.g. 0.83 for CONSTRUCTION basic-tier
  alertThreshold  Float    @default(0.85)     // warn when used/limit >= this
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sector, workerTier])
  @@map("drc_quota_configs")
}

enum JobStatus {
  DRAFT
  OPEN
  FILLED
  CANCELLED
}
enum PipelineStage {
  APPLIED
  SCREENING
  INTERVIEW_1
  INTERVIEW_2
  ASSESSMENT
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}
