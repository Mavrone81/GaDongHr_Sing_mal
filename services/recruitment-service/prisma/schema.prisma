// Prisma schema for recruitment-service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model JobPosting {
  id              String     @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  title           String
  department      String
  headcount       Int        @default(1)
  jobDescription  String
  requirements    String?
  salaryMin       Float?
  salaryMax       Float?
  jobType         String     @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT
  location        String?
  mcfJobId        String?    // MyCareersFuture reference
  mcfPostedAt     DateTime?  // when posted on MCF
  mcfExpiredAt    DateTime?  // must be 14 days before shortlisting
  fcfCompliant    Boolean    @default(false)
  // REC-002 FCF exemption + audit
  fcfExempt        Boolean    @default(false)  // true when job qualifies for FCF exemption (salary ≥ S$30k/mo, intra-corporate transfer, etc.)
  fcfExemptReason  String?                     // one of: HIGH_SALARY | INTRA_CORPORATE | SHORTAGE_OCCUPATION | OTHER
  fcfExemptNote    String?                     // free-text justification
  fcfExemptBy      String?
  fcfExemptAt      DateTime?
  fcfNotes         String?                     // recruiter notes on FCF posting/compliance
  status          JobStatus  @default(DRAFT)
  postedById      String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  candidates      Candidate[]

  @@index([fcfCompliant])
  @@index([fcfExempt])
  @@index([tenantId])
  @@map("job_postings")
}

model Candidate {
  id              String     @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  jobId           String?
  firstName       String
  lastName        String
  email           String
  phone           String?
  currentEmployer String?
  currentTitle    String?
  noticePeriod    Int?
  expectedSalary  Float?
  resumePath      String?
  resumeName      String?
  stage           PipelineStage @default(APPLIED)
  isOfferMade     Boolean    @default(false)
  isHired         Boolean    @default(false)
  employeeId      String?
  notes           String?
  // REC-002 FCF audit fields — nationality + shortlisting / hiring rationale
  nationality     String?            // ISO country code or "SC" | "PR" | free-text (e.g. "Indian", "Chinese")
  citizenStatus   CitizenshipKind?   // bucketed for the nationality breakdown report
  shortlistingNotes String?          // why the candidate was/wasn't shortlisted
  hiringRationale   String?          // why this candidate was chosen over others
  rejectionReason   String?          // FCF audit — why a candidate was rejected
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  job              JobPosting?    @relation(fields: [jobId], references: [id])
  interviewRounds  InterviewRound[]
  stageEvents      CandidateStageEvent[]

  @@index([citizenStatus])
  @@index([tenantId])
  @@map("candidates")
}

enum CitizenshipKind {
  CITIZEN
  PR
  FOREIGNER
}

model CandidateStageEvent {
  id          String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  candidateId String
  fromStage   String?
  toStage     String
  note        String?
  changedBy   String?
  createdAt   DateTime @default(now())

  candidate   Candidate @relation(fields: [candidateId], references: [id])

  @@index([candidateId])
  @@index([tenantId])
  @@map("candidate_stage_events")
}

model InterviewRound {
  id            String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  candidateId   String
  roundName     String
  scheduledAt   DateTime
  interviewerIds String[]
  notes         String?
  result        String?  // PASS | FAIL | PENDING
  createdAt     DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@index([tenantId])
  @@map("interview_rounds")
}

model OnboardingTask {
  id          String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId  String
  taskName    String
  description String?
  assignedTo  String?  // userId
  dueDate     DateTime?
  isDone      Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([employeeId])
  @@index([tenantId])
  @@map("onboarding_tasks")
}

model BuddyAssignment {
  id          String    @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId  String    @unique   // the new hire
  buddyId     String              // buddy's employeeId from employee-service
  buddyName   String?             // cached display name
  newHireName String?             // cached display name
  startDate   DateTime?           // new hire's start date (for buddy planning)
  assignedBy  String              // HR user sub who made the assignment
  assignedAt  DateTime  @default(now())
  note        String?

  @@index([buddyId])
  @@index([tenantId])
  @@map("buddy_assignments")
}

model WorkPass {
  id           String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId   String   @unique
  passType     String
  passNumber   String
  expiryDate   DateTime
  issuedDate   DateTime?
  status       String   @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED | RENEWING
  // REC-003 renewal lifecycle
  sector              String?    // for DRC quota (e.g. CONSTRUCTION, MANUFACTURING, SERVICES, MARINE, PROCESS)
  workerTier          String?    // BASIC | HIGHER (for FWL/DRC quota)
  renewalInitiatedAt  DateTime?
  renewalSubmittedAt  DateTime?
  renewalOutcome      String?    // APPROVED | REJECTED | WITHDRAWN
  renewalOutcomeAt    DateTime?
  renewalReference    String?    // MOM reference
  renewalNotes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  alerts       WorkPassAlert[]
  checklistItems WorkPassRenewalChecklist[]

  @@index([tenantId])
  @@map("work_passes")
}

// REC-003: idempotent alert ledger for work-pass expiry. One row per
// (workPassId, threshold) — daily sweep upserts so re-runs don't fan out
// duplicate notifications.
model WorkPassAlert {
  id          String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  workPassId  String
  employeeId  String   // denormalised for fast dashboard queries
  passType    String
  threshold   Int      // 90 | 60 | 30 | 0 (0 = expired)
  expiryDate  DateTime
  message     String
  notifiedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  workPass    WorkPass @relation(fields: [workPassId], references: [id], onDelete: Cascade)

  @@unique([workPassId, threshold])
  @@index([employeeId])
  @@index([expiryDate])
  @@index([tenantId])
  @@map("work_pass_alerts")
}

// REC-003: per-pass-type renewal checklist items. HR ticks each off.
model WorkPassRenewalChecklist {
  id          String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  workPassId  String
  itemName    String
  isComplete  Boolean  @default(false)
  completedAt DateTime?
  completedBy String?
  notes       String?
  createdAt   DateTime @default(now())

  workPass    WorkPass @relation(fields: [workPassId], references: [id], onDelete: Cascade)

  @@index([workPassId])
  @@index([tenantId])
  @@map("work_pass_renewal_checklist")
}

// REC-003: DRC quota configuration per sector × worker tier.
// MOM sets the maximum ratio of S-Pass + Work Permit holders to total
// workforce per sector. ratioLimit is the ceiling; alertThreshold is the
// "approaching cap" warn level (e.g. 0.85 = warn at 85% of cap).
model DrcQuotaConfig {
  id              String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  sector          String
  workerTier      String   @default("BASIC")  // BASIC | HIGHER
  ratioLimit      Float    // e.g. 0.83 for CONSTRUCTION basic-tier
  alertThreshold  Float    @default(0.85)     // warn when used/limit >= this
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sector, workerTier])
  @@index([tenantId])
  @@map("drc_quota_configs")
}

// REC-004: HR-managed policy documents requiring new-hire acknowledgement.
// HR Admin seeds / manages these; employees acknowledge each one during onboarding.
model PolicyDocument {
  id           String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  code         String   @unique  // HANDBOOK | HARASSMENT_POLICY | PDPA_CONSENT | IT_ACCEPTABLE_USE | OTHER
  title        String
  description  String?
  documentUrl  String?           // link to hosted document content
  documentHash String?           // SHA-256 of current document version (for audit)
  version      String   @default("1.0")
  isRequired   Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  acknowledgements PolicyAcknowledgement[]

  @@index([tenantId])
  @@map("policy_documents")
}

// Per-employee acknowledgement record. Created PENDING when a candidate is
// hired; employee flips to ACKNOWLEDGED via the ESS portal.
model PolicyAcknowledgement {
  id             String    @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId     String
  documentId     String
  status         AckStatus @default(PENDING)
  acknowledgedAt DateTime?
  ipAddress      String?   // client IP captured at moment of acknowledgement
  documentHash   String?   // document version hash at acknowledgement time
  createdAt      DateTime  @default(now())

  document PolicyDocument @relation(fields: [documentId], references: [id])

  @@unique([employeeId, documentId])
  @@index([employeeId])
  @@index([status])
  @@index([tenantId])
  @@map("policy_acknowledgements")
}

enum AckStatus {
  PENDING
  ACKNOWLEDGED
}

enum OfferLetterStatus {
  DRAFT
  SENT
  SIGNED
  DECLINED
  EXPIRED
  REVOKED
}

// REC-001: Offer letter generated on candidate approval, sent for e-sign via ESV-003.
model OfferLetter {
  id                 String            @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  candidateId        String            @unique
  jobTitle           String
  department         String?
  startDate          DateTime?
  offeredSalary      Float?
  probationMonths    Int               @default(3)
  reportingManager   String?
  additionalTerms    String?
  status             OfferLetterStatus @default(DRAFT)
  esignRequestId     String?           // ESV-003 signing request ID
  signedAt           DateTime?
  declinedAt         DateTime?
  declinedReason     String?
  expiresAt          DateTime?
  generatedBy        String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status])
  @@index([tenantId])
  @@map("offer_letters")
}

enum JobStatus {
  DRAFT
  OPEN
  FILLED
  CANCELLED
}
enum PipelineStage {
  APPLIED
  SCREENING
  INTERVIEW_1
  INTERVIEW_2
  ASSESSMENT
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}
