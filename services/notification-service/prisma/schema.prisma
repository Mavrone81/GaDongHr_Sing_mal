// Prisma schema for notification-service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Notification {
  id          String           @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  // userId holds either a real user sub OR 'role:HR_ADMIN' for role broadcasts
  userId      String
  type        NotifType        @default(IN_APP)
  title       String
  body        String
  category    String?          // PAYROLL | LEAVE | ONBOARDING | ATTENDANCE | SYSTEM etc.
  link        String?          // frontend path to navigate to on click
  isRead      Boolean          @default(false)
  readAt      DateTime?
  meta        Json?
  createdAt   DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([tenantId])
  @@map("notifications")
}

enum NotifType {
  IN_APP
  EMAIL
  SMS
}
