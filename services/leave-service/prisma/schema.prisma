// Prisma schema for leave-service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LeaveType {
  id                  String    @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  code                String
  name                String
  isStatutory         Boolean   @default(false)
  isPaid              Boolean   @default(true)
  annualEntitlement   Float     @default(0)  // days per year
  maxCarryForward     Float     @default(0)
  isGovtPaid          Boolean   @default(false) // GPML, GPPL etc
  // LEA-005: MSF reimbursement caps. All null = no cap configured (claim is
  // taken at the employee's actual daily rate × days). When any cap is set,
  // the claim engine clamps total reimbursement to the LOWEST applicable cap.
  msfDailyCap         Float?    // SGD/day (e.g. CCL SGD 100/day)
  msfWeeklyCap        Float?    // SGD/week (e.g. GPPL SGD 2,500/week, CCL SGD 500/week)
  msfPeriodCap        Float?    // SGD total per claim period (e.g. GPML SGD 10,000 per 4-week block)
  msfPeriodWeeks      Int?      // number of weeks in one MSF claim period (GPML = 4, others usually 1)
  requiresDocument    Boolean   @default(false)
  minNoticeDays       Int       @default(0)
  minServiceMonths    Int       @default(0)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())

  applications        LeaveApplication[]
  entitlements        LeaveEntitlement[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("leave_types")
}

model LeaveEntitlement {
  id                 String    @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId         String
  leaveTypeId        String
  year               Int
  entitledDays       Float
  usedDays           Float     @default(0)
  pendingDays        Float     @default(0)
  carryForward       Float     @default(0)
  expiredDays        Float     @default(0)
  // PAY-LEA-007: explicit expiry timestamp for the carry-forward balance.
  // Defaults to 31 Dec of `year` at 23:59:59. Set null to make carry-forward
  // never expire (rare; HR override). The daily sweep zeros carryForward and
  // pushes the remainder into expiredDays after this timestamp passes.
  carryForwardExpiry DateTime?
  updatedAt          DateTime  @updatedAt

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([carryForwardExpiry])
  @@index([tenantId])
  @@map("leave_entitlements")
}

model LeaveApplication {
  id                   String        @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId           String
  leaveTypeId          String
  startDate            DateTime
  endDate              DateTime
  totalDays            Float
  reason               String?
  documentPath         String?
  status               AppStatus     @default(PENDING)
  approvedById         String?
  approvedAt           DateTime?
  rejectedReason       String?
  isHalfDay            Boolean       @default(false)
  halfDaySlot          String?       // AM | PM
  govtClaimRef         String?       // for govt-paid leave claims (legacy — superseded by MSF claim fields below)
  // LEA-005: per-application MSF claim tracking. Populated by POST
  // /leave/govt-claims/generate using the leave-type's MSF caps.
  claimStatus          ClaimStatus   @default(NOT_APPLICABLE)
  claimAmount          Float?        // capped reimbursement amount in SGD
  claimDailyRate       Float?        // pre-cap daily rate used in computation (audit)
  claimUncappedAmount  Float?        // pre-cap raw amount (audit — shows where the cap bit)
  claimCapApplied      String?       // which cap binding-cap clamped the claim: 'DAILY' | 'WEEKLY' | 'PERIOD' | 'NONE'
  claimSubmissionRef   String?       // government reference returned after submission
  claimSubmittedAt     DateTime?
  claimReimbursedAt    DateTime?
  claimReimbursedAmount Float?       // actual amount reimbursed (may differ from claimAmount if govt approves less)
  claimRejectedReason  String?
  claimNotes           String?
  currentApprovalStep  Int           @default(1)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  leaveType      LeaveType          @relation(fields: [leaveTypeId], references: [id])
  approvalSteps  LeaveApprovalStep[]

  @@index([employeeId])
  @@index([status])
  @@index([claimStatus])
  @@index([tenantId])
  @@map("leave_applications")
}

enum ClaimStatus {
  NOT_APPLICABLE  // not a govt-paid leave
  NOT_SUBMITTED   // claim computed but not yet sent to MSF
  SUBMITTED       // sent, awaiting reimbursement
  REIMBURSED      // funds received
  REJECTED        // MSF rejected the claim
}

model LeaveApprovalStep {
  id                  String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  applicationId       String
  step                Int
  approvedByEmpId     String
  approvedAt          DateTime @default(now())

  application LeaveApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([tenantId])
  @@map("leave_approval_steps")
}

model PublicHoliday {
  id        String   @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  date      DateTime
  name      String
  year      Int
  createdAt DateTime @default(now())

  @@unique([date])
  @@index([tenantId])
  @@map("public_holidays")
}

enum AppStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
}

// ── Child records for CCL / UICL / ECL entitlement automation ─────────────────

model ChildRecord {
  id                 String           @id @default(uuid())
  tenantId String @default("00000000-0000-0000-0000-000000000001")
  employeeId         String
  fullName           String
  dateOfBirth        DateTime
  citizenship        ChildCitizenship
  verificationStatus ChildVerifStatus @default(PENDING)
  verifiedBy         String?          // userId who verified
  verifiedAt         DateTime?
  rejectedReason     String?
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([employeeId])
  @@index([verificationStatus])
  @@index([tenantId])
  @@map("child_records")
}

enum ChildCitizenship {
  SC
  PR
  FOREIGNER
}

enum ChildVerifStatus {
  PENDING
  VERIFIED
  REJECTED
}
