# ============================================================
# GaDongHR Environment Variables
# Copy to .env and fill in all values before running
# ============================================================

# ---- Encryption (AES-256-GCM) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_key_here

# ---- JWT (RS256 keypairs auto-generated on first run) ----
# Or set explicitly for production:
JWT_PRIVATE_KEY_PATH=./certs/private.pem
JWT_PUBLIC_KEY_PATH=./certs/public.pem
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=hrms
POSTGRES_PASSWORD=hrms_secret_2025
POSTGRES_ROOT_DB=postgres

# Per-service DB names (auto-created on first run)
AUTH_DB=hrms_auth
EMPLOYEE_DB=hrms_employee
PAYROLL_DB=hrms_payroll
LEAVE_DB=hrms_leave
CLAIMS_DB=hrms_claims
RECRUITMENT_DB=hrms_recruitment
ATTENDANCE_DB=hrms_attendance
OFFBOARDING_DB=hrms_offboarding
NOTIFICATION_DB=hrms_notification
REPORTING_DB=hrms_reporting

# ---- SMTP (Nodemailer) — Zoho Mail, sender enquiries@bevorasg.com ----
# Zoho requires an APP-SPECIFIC password whenever 2FA is on; the account
# password will not authenticate over SMTP.
#   Zoho Accounts -> Security -> App Passwords -> generate one for "HRMS SMTP"
#
# SMTP_HOST depends on the data centre the Zoho account was created in:
#   smtp.zoho.com (US) | smtp.zoho.eu (EU) | smtp.zoho.in (IN) | smtp.zoho.com.au (AU)
# The wrong one fails as a TIMEOUT rather than an auth error, which is slow to
# diagnose — check the URL you land on when signing in to Zoho.
#
# 465 = implicit TLS, 587 = STARTTLS. notification-service and reporting-service
# both treat `secure` as (SMTP_SECURE === 'true' || port === 465), so keep these
# two consistent with each other.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=enquiries@bevorasg.com
SMTP_PASS=your_zoho_app_password
SMTP_FROM=GaDongHR <enquiries@bevorasg.com>

# ---- Service Ports ----
API_GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4001
EMPLOYEE_SERVICE_PORT=4002
PAYROLL_SERVICE_PORT=4003
LEAVE_SERVICE_PORT=4004
CLAIMS_SERVICE_PORT=4005
RECRUITMENT_SERVICE_PORT=4006
ATTENDANCE_SERVICE_PORT=4007
OFFBOARDING_SERVICE_PORT=4008
NOTIFICATION_SERVICE_PORT=4009
REPORTING_SERVICE_PORT=4010

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api
FRONTEND_PORT=3000

# ---- Database backups (hrms-db-backup container) ----
# pg_dumpall runs daily at 0 19 * * * UTC = 03:00 SGT. Override schedule/retention:
BACKUP_CRON="0 19 * * *"
BACKUP_RETENTION_DAYS=14
# Off-box copy to S3-compatible storage. Leave S3_BUCKET empty to keep backups
# local-only. Example below is for Cloudflare R2 (S3_ENDPOINT is the R2 S3 API URL;
# region must be 'auto'). For AWS S3 leave S3_ENDPOINT empty and set a real region.
S3_BUCKET=
S3_PREFIX=hrms-db-backups
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# ---- App ----
NODE_ENV=development
LOG_LEVEL=info
COMPANY_UEN=202512345A
COMPANY_NAME="GaDongHR Pte Ltd"

# ---- AI assistant (floating chat) ----
# Provider-agnostic. Pick ONE (auto-detected):
#   Free:  GROQ_API_KEY   -> get at https://console.groq.com/keys (no card)
#   Paid:  ANTHROPIC_API_KEY -> https://console.anthropic.com/settings/keys
# Leave ASSISTANT_MODEL blank to auto-pick (Groq -> llama-3.3-70b-versatile;
# Anthropic -> claude-haiku-4-5). Leave all blank to disable the chat.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
ASSISTANT_PROVIDER=
ASSISTANT_MODEL=
