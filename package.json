{
  "name": "ezy-hrms",
  "version": "1.0.0",
  "description": "Vorkhive - Singapore-compliant HRMS Microservice System",
  "private": true,
  "workspaces": [
    "shared/*",
    "services/*",
    "frontend"
  ],
  "scripts": {
    "dev": "docker-compose up --build",
    "down": "docker-compose down",
    "logs": "docker-compose logs -f",
    "seed": "node scripts/seed.js",
    "test:backend": "jest --maxWorkers=2 --testPathIgnorePatterns=/node_modules/ --testPathIgnorePatterns=frontend --testPathIgnorePatterns=e2e",
    "test:frontend": "jest --maxWorkers=2 --projects frontend",
    "test:e2e": "cd e2e && npm test",
    "test:rbac": "cd e2e && npm run test:rbac",
    "test:smoke": "cd e2e && npm run test:smoke",
    "test:all": "npm run test:backend && npm run test:frontend && npm run test:e2e",
    "test:e2e:seed": "cd e2e && npm run seed-test-users"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "pg": "^8.20.0",
    "uuid": "^10.0.0"
  }
}
